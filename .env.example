# Neon (use the pooled connection string)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Cloudinary dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# One-time seed of the first Super Admin (password 12+ chars)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Password-reset and contact emails via Brevo (https://app.brevo.com). Verify the sender (or domain) in Brevo first.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UMaT Essikado SRC
# Optional: where contact-form emails go if Settings has no contact email
CONTACT_NOTIFY_EMAIL=
